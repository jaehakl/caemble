# Browser requests stay on the same origin; Vite and the production reverse proxy
# both forward /api to FastAPI without the /api prefix.
VITE_API_BASE_URL=/api

# npm run dev starts the application on localhost:5173 and the isolated runner
# on localhost:5174. When omitted in development, the runner uses the host port
# plus one. Set both values when using custom development origins or production.
# VITE_CAEMBLE_HOST_ORIGIN=https://app.example.com
# VITE_CAEMBLE_RUNNER_ORIGIN=https://cad-runner.example.com
