{
  "name": "caemble-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names app,runner \"npm:dev:app\" \"npm:dev:runner\"",
    "dev:app": "vite",
    "dev:runner": "vite --config vite.runner.config.ts",
    "build:sdk": "npm --prefix ../sdk/master/js run build",
    "build": "npm run build:sdk && npm run check:generated && tsc -b && vite build && node scripts/check-production-assets.mjs",
    "check:generated": "node scripts/generate-cad-api.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "generate:cad-api": "node scripts/generate-cad-api.mjs",
    "export:cae-fixture": "node scripts/export-cae-fixture.mjs",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.contract.test.{ts,tsx}\"",
    "test:contracts": "vitest run contract.test",
    "test:full": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build:production-e2e && playwright test --config playwright.production.config.ts --grep \"manages Experiment namespace\"",
    "build:production-e2e": "npm run build:sdk && npm run check:generated && tsc -b && vite build --mode production-e2e && node scripts/check-production-assets.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fhir-toolkit/ucum": "0.2.0",
    "@gpstation/v1-master-js-sdk": "file:../sdk/master/js",
    "@hookform/resolvers": "^5.4.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@jscad/modeling": "^2.13.0",
    "@jscad/regl-renderer": "^2.6.15",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.25.0",
    "ml-kmeans": "^7.0.1",
    "ml-matrix": "^6.13.0",
    "ml-pca": "^4.1.1",
    "ml-random-forest": "^2.1.0",
    "monaco-editor": "0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-statistics": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.13.0",
    "@lhncbc/ucum-lhc": "7.1.8",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.4",
    "esbuild": "0.21.5",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}
