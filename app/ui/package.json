{
  "name": "caemble-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names app,runner \"npm:dev:app\" \"npm:dev:runner\"",
    "dev:app": "vite",
    "dev:runner": "vite --config vite.runner.config.ts",
    "build:sdk": "npm --prefix ../sdk/master/js run build",
    "build": "npm run build:sdk && npm run check:calculation-agent && tsc -b && vite build && npm run check:calculation-build",
    "generate:calculation-agent": "esbuild scripts/generate-calculation-agent-reference.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/generate-calculation-agent-reference.mjs && node node_modules/.tmp/generate-calculation-agent-reference.mjs",
    "check:calculation-agent": "esbuild scripts/generate-calculation-agent-reference.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/generate-calculation-agent-reference.mjs && node node_modules/.tmp/generate-calculation-agent-reference.mjs --check",
    "generate:cad-api": "node scripts/generate-cad-api.mjs",
    "check:calculation-build": "node scripts/check-calculation-build.mjs",
    "test:ai-agent": "esbuild scripts/test-ai-agent-conversation.ts --bundle --platform=node --format=esm --define:import.meta.env={} --alias:@=./src --outfile=node_modules/.tmp/test-ai-agent-conversation.mjs && node node_modules/.tmp/test-ai-agent-conversation.mjs",
    "test:calculation": "esbuild scripts/test-calculation-runtime.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=node_modules/.tmp/test-calculation-runtime.cjs && node node_modules/.tmp/test-calculation-runtime.cjs && esbuild scripts/test-calculation-compiler-cache.ts --bundle --platform=node --format=cjs --alias:@/lib/cad/compiler/monacoRuntime=./scripts/calculation-monaco-stub.ts --alias:@=./src --outfile=node_modules/.tmp/test-calculation-compiler-cache.cjs && node node_modules/.tmp/test-calculation-compiler-cache.cjs && esbuild scripts/test-calculation-data-batch.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/test-calculation-data-batch.mjs && node node_modules/.tmp/test-calculation-data-batch.mjs && esbuild scripts/test-calculation-heatmap.tsx --bundle --platform=node --format=cjs --jsx=automatic --alias:@/features/viewer/viewer/RecordedDataResults=./scripts/calculation-line-chart-stub.tsx --alias:@=./src --outfile=node_modules/.tmp/test-calculation-heatmap.cjs && node node_modules/.tmp/test-calculation-heatmap.cjs",
    "test:vars": "esbuild scripts/test-vars-tensor.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=node_modules/.tmp/test-vars-tensor.cjs && node node_modules/.tmp/test-vars-tensor.cjs",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fhir-toolkit/ucum": "0.2.0",
    "@gpstation/v1-master-js-sdk": "file:../sdk/master/js",
    "@jridgewell/trace-mapping": "0.3.31",
    "@jscad/modeling": "^2.13.0",
    "@jscad/regl-renderer": "^2.6.15",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.25.0",
    "manifold-3d": "3.5.1",
    "mathjs": "15.2.0",
    "ml-kmeans": "^7.0.1",
    "ml-matrix": "^6.13.0",
    "ml-pca": "^4.1.1",
    "ml-random-forest": "^2.1.0",
    "monaco-editor": "0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-statistics": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.4",
    "esbuild": "^0.21.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "^5.4.10"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}
