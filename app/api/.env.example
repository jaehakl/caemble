DB_URL=postgresql+asyncpg://caemble:caemble@localhost:5432/caemble

GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_ID_TOKEN_CLOCK_SKEW_SEC=10

APP_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_APP_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Seoul
OAUTH_STATE_TTL_SEC=600

# Use at least 32 random bytes. Never commit the production value.
JWT_SECRET=replace-with-at-least-32-random-bytes
CSRF_TTL_SEC=3600

# Encrypts per-user external AI provider keys at rest. Values are comma-separated
# URL-safe Fernet keys, with the newest primary key first. Never commit real keys.
# Generate one with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode('ascii'))"
AI_CREDENTIAL_FERNET_KEYS=replace-with-generated-fernet-key

# Leave COOKIE_DOMAIN empty for localhost. Use HTTPS-only cookies in production.
COOKIE_DOMAIN=
SECURE_COOKIES=false
