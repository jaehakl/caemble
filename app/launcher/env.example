# Caemble API base. The launcher connects to /v1/launchers/control.
# The corresponding GPSTATION_V1_* names remain supported as fallbacks.
CAEMBLE_API_URL=http://127.0.0.1:8000

# Create this in Caemble with the "launcher" scope.
CAEMBLE_ACCESS_TOKEN=replace-with-launcher-scope-access-token

# CAEMBLE_LAUNCHER_NAME=
CAEMBLE_HEARTBEAT_INTERVAL_SECONDS=5
CAEMBLE_WORKER_READY_TIMEOUT_SECONDS=10

# WebRTC ICE servers passed to slave subprocesses.
# Google STUN improves peer discovery but does not relay traffic.
# Restrictive NAT or firewall combinations can still prevent a connection.
CAEMBLE_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Shortens aiortc/aioice's non-trickle ICE gather wait for STUN-only setups.
# Increase to 2.0 or 3.0 if srflx candidates disappear on slower networks.
CAEMBLE_RTC_ICE_GATHER_TIMEOUT_SECONDS=1.0

# Keeps one live pre-gathered WebRTC peer in each worker subprocess for the next job.
# CAEMBLE_RTC_MEMORY_CACHE_ENABLED=true
