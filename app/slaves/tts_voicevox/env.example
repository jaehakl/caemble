# Copy this file to app/slaves/tts_voicevox/.env for VOICEVOX runtime settings.

# Install with: poetry run python scripts/install_voicevox.py --device cuda
# Use --device cpu for CPU-only machines. Jobs select devices from Launcher allocations.
# Relative paths are resolved from app/slaves/tts_voicevox.
VOICEVOX_RUNTIME_DIR=voicevox_runtime
# 0 lets VOICEVOX Core choose the CPU thread count automatically.
VOICEVOX_CPU_NUM_THREADS=0
